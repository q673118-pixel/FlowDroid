<Window x:Class="FlowDroid.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — FlowDroid" Width="820" Height="760" MinWidth="720" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <Border Background="{StaticResource WindowBrush}" CornerRadius="20" Padding="30" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Настройки FlowDroid" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="Общие параметры приложения и значения по умолчанию для новых профилей." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="Закрыть" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="16,9" Click="Close_Click"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,20">
                <StackPanel>
                    <TextBlock Text="Персонализация" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Язык интерфейса" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Переключение языка приложения." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="LanguageBox" Width="190" Height="42" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Personalization_SelectionChanged">
                                    <ComboBoxItem Content="Русский" Tag="Русский"/>
                                    <ComboBoxItem Content="English" Tag="English"/>
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{StaticResource OutlineBrush}" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Шрифт приложения" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Выберите гарнитуру для всего интерфейса." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="FontBox" Width="190" Height="42" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Personalization_SelectionChanged">
                                    <ComboBoxItem Content="Segoe UI Variable" Tag="Segoe UI Variable"/>
                                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
                                    <ComboBoxItem Content="Arial" Tag="Arial"/>
                                    <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                                    <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                                    <ComboBoxItem Content="Georgia" Tag="Georgia"/>
                                </ComboBox>
                            </Grid>
                            <Border x:Name="FontPreviewCard" Background="{StaticResource SurfaceVariantBrush}" CornerRadius="13" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Предпросмотр шрифта" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                    <TextBlock x:Name="FontPreviewText" Text="FlowDroid — Android emulator" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="0123456789  Aa Бб" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Скорость анимаций" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Настройте темп переходов и появления элементов." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="MotionSpeedBox" Width="190" Height="42" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="Personalization_SelectionChanged">
                                    <ComboBoxItem Content="Медленно" Tag="1.35"/>
                                    <ComboBoxItem Content="Обычно" Tag="1"/>
                                    <ComboBoxItem Content="Быстро" Tag="0.75"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Новые профили" FontSize="19" FontWeight="SemiBold" Margin="0,24,0,12"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Оперативная память по умолчанию (ГБ)"/>
                            <ComboBox x:Name="RamBox" Height="42" Margin="0,7,0,14">
                                <ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/><ComboBoxItem Content="12"/><ComboBoxItem Content="16"/>
                            </ComboBox>
                            <TextBlock Text="Количество ядер CPU по умолчанию"/>
                            <ComboBox x:Name="CpuBox" Height="42" Margin="0,7,0,14">
                                <ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/><ComboBoxItem Content="12"/>
                            </ComboBox>
                            <TextBlock Text="Целевая частота кадров по умолчанию"/>
                            <ComboBox x:Name="FpsBox" Height="42" Margin="0,7,0,0">
                                <ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="90"/><ComboBoxItem Content="120"/><ComboBoxItem Content="144"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Поведение" FontSize="19" FontWeight="SemiBold" Margin="0,24,0,12"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                        <CheckBox x:Name="ConfirmDeleteCheckBox" Content="Запрашивать подтверждение перед удалением профиля" IsChecked="True" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                    </Border>
                    <TextBlock Text="Внешний вид" FontSize="19" FontWeight="SemiBold" Margin="0,24,0,12"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Темы, цвета и анимации" FontWeight="SemiBold"/>
                                <TextBlock Text="Светлая, тёмная и системная темы, шесть вариантов акцента." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Content="Открыть" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,9" Click="Appearance_Click"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Хранилище" FontSize="19" FontWeight="SemiBold" Margin="0,24,0,12"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="16" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Папка данных FlowDroid" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DataPathText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,12"/>
                            <Button Content="Открыть папку данных" HorizontalAlignment="Left" Padding="15,9" Click="OpenDataFolder_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Padding="16,10" Margin="0,0,10,0" Click="Close_Click"/>
                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Padding="18,10" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>