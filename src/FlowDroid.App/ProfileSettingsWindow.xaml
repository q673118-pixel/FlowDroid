<Window x:Class="FlowDroid.ProfileSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Настройки профиля" Width="620" Height="700" MinHeight="620" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
<Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Настройки профиля" FontSize="26" FontWeight="Bold"/><TextBlock Text="Параметры сохраняются в профиле. Их применение к Android-среде появится после подключения движка." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,22"/>
<TextBlock Text="Экран и визуал" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
<TextBlock Text="Разрешение"/><ComboBox x:Name="ResolutionBox" Margin="0,5,0,12" Height="38"><ComboBoxItem Content="1280 × 720"/><ComboBoxItem Content="1600 × 900"/><ComboBoxItem Content="1920 × 1080"/><ComboBoxItem Content="2560 × 1440"/></ComboBox>
<TextBlock Text="DPI"/><ComboBox x:Name="DpiBox" Margin="0,5,0,12" Height="38"><ComboBoxItem Content="160"/><ComboBoxItem Content="200"/><ComboBoxItem Content="240"/><ComboBoxItem Content="280"/><ComboBoxItem Content="320"/></ComboBox>
<TextBlock Text="Ориентация"/><ComboBox x:Name="OrientationBox" Margin="0,5,0,18" Height="38"><ComboBoxItem Content="Альбомная"/><ComboBoxItem Content="Книжная"/></ComboBox>
<TextBlock Text="Производительность" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
<TextBlock Text="Оперативная память (ГБ)"/><ComboBox x:Name="RamBox" Margin="0,5,0,12" Height="38"><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/></ComboBox>
<TextBlock Text="Количество ядер CPU"/><ComboBox x:Name="CpuBox" Margin="0,5,0,12" Height="38"><ComboBoxItem Content="2"/><ComboBoxItem Content="4"/><ComboBoxItem Content="6"/><ComboBoxItem Content="8"/></ComboBox>
<TextBlock Text="Целевая частота кадров"/><ComboBox x:Name="FpsBox" Margin="0,5,0,12" Height="38"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="90"/><ComboBoxItem Content="120"/></ComboBox>
<TextBlock Text="Графический рендерер"/><ComboBox x:Name="RendererBox" Margin="0,5,0,20" Height="38"><ComboBoxItem Content="Автоматически"/><ComboBoxItem Content="OpenGL"/><ComboBoxItem Content="Vulkan"/></ComboBox>
</StackPanel></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Отмена" Padding="16,9" Margin="0,0,10,0" Background="{StaticResource SurfaceVariantBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" Click="Cancel_Click"/><Button Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Grid></Window>