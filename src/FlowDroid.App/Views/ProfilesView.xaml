<UserControl x:Class="FlowDroid.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FlowDroid.Controls">
    <Grid Margin="48,52,48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Профили" FontSize="40" FontWeight="Bold"/>
                <TextBlock Text="{Binding Profiles.ProfileCountText}" FontSize="16"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="2,4,0,0"/>
            </StackPanel>
            <TextBox Width="340" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource SearchBox}"
                     ctl:Ui.Placeholder="Поиск профилей…"
                     Text="{Binding Profiles.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl DataContext="{Binding Profiles}" ItemsSource="{Binding Tiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="360" Margin="0,0,40,0"
                        Visibility="{Binding Profiles.ShowNoResults, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Ничего не найдено" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="Измените поисковый запрос." FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
