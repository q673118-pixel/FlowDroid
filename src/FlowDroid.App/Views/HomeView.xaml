<UserControl x:Class="FlowDroid.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:FlowDroid.Controls">
    <Grid Margin="48,52,48,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero: brand title and the Android mark -->
        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="FlowDroid" FontSize="64" FontWeight="Bold"/>
                <TextBlock Text="Android-эмулятор для Windows" FontSize="24" FontWeight="Medium"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,0"/>
            </StackPanel>
            <ctl:AndroidMark Width="250" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0"
                             Fill="{DynamicResource AccentBrightBrush}" EyeBrush="{DynamicResource WindowBrush}"/>
        </Grid>

        <!-- Section header: title, search, filter -->
        <Grid Grid.Row="1" Margin="0,34,0,26">
            <TextBlock Text="Ваши профили" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox Width="340" Style="{DynamicResource SearchBox}" ctl:Ui.Placeholder="Поиск профилей…"
                         Text="{Binding Profiles.SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Grid Margin="12,0,0,0">
                    <Button x:Name="FilterButton" Style="{DynamicResource TonalIconButton}" Content="&#xE71C;"
                            ToolTip="Сортировка и фильтры" Click="FilterButton_Click"/>
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrightBrush}" IsHitTestVisible="False"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                             Visibility="{Binding Profiles.IsFilterActive, Converter={StaticResource BoolToVisibility}}"/>
                    <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                           HorizontalOffset="-212" VerticalOffset="10" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="264" Margin="0,0,0,8" Padding="18,16,10,8" CornerRadius="22"
                                Background="{DynamicResource SurfaceElevatedBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Сортировка" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Style="{DynamicResource ChipRadioButton}" GroupName="ProfileSort" Content="По названию"
                                                 IsChecked="{Binding Profiles.SortByName, Mode=TwoWay}"/>
                                    <RadioButton Style="{DynamicResource ChipRadioButton}" GroupName="ProfileSort" Content="По числу APK"
                                                 IsChecked="{Binding Profiles.SortByApkCount, Mode=TwoWay}"/>
                                </WrapPanel>
                                <TextBlock Text="Показывать" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,10"/>
                                <WrapPanel>
                                    <RadioButton Style="{DynamicResource ChipRadioButton}" GroupName="ProfileFilter" Content="Все"
                                                 IsChecked="{Binding Profiles.FilterAll, Mode=TwoWay}"/>
                                    <RadioButton Style="{DynamicResource ChipRadioButton}" GroupName="ProfileFilter" Content="С APK"
                                                 IsChecked="{Binding Profiles.FilterWithApks, Mode=TwoWay}"/>
                                    <RadioButton Style="{DynamicResource ChipRadioButton}" GroupName="ProfileFilter" Content="Без APK"
                                                 IsChecked="{Binding Profiles.FilterEmpty, Mode=TwoWay}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Content: tiles on the left; when there are no profiles the empty state fills the right side -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl DataContext="{Binding Profiles}" ItemsSource="{Binding Tiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                        Visibility="{Binding Profiles.HasNoProfiles, Converter={StaticResource BoolToVisibility}}">
                <!-- Tilted phone with a small Android mark -->
                <Grid Width="150" Height="170" HorizontalAlignment="Center">
                    <Border Width="96" Height="136" CornerRadius="22" BorderThickness="6"
                            BorderBrush="{DynamicResource AccentBrightBrush}" Background="{DynamicResource SurfaceBrush}"
                            RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.RenderTransform>
                            <RotateTransform Angle="12"/>
                        </Border.RenderTransform>
                        <ctl:AndroidMark Width="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentBrightBrush}" EyeBrush="{DynamicResource SurfaceBrush}"/>
                    </Border>
                    <Canvas IsHitTestVisible="False">
                        <Line X1="124" Y1="30" X2="136" Y2="18" Stroke="{DynamicResource AccentBrightBrush}"
                              StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="132" Y1="44" X2="146" Y2="40" Stroke="{DynamicResource AccentBrightBrush}"
                              StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Grid>
                <TextBlock Text="У вас пока нет профилей" FontSize="24" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock Text="Создайте профиль, чтобы запускать свои игры и приложения" FontSize="15"
                           Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <Button Style="{DynamicResource PillButton}" Margin="0,26,0,0" HorizontalAlignment="Stretch"
                        Command="{Binding Profiles.CreateProfileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Создать профиль" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Search / filter found nothing -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                        Visibility="{Binding Profiles.ShowNoResults, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Ничего не найдено" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="Измените запрос или параметры фильтра." FontSize="14"
                           Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
