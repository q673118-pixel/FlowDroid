<UserControl x:Class="FlowDroid.Views.SectionPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <!-- Honest stand-in for sections that are not built yet. It states what is missing instead of faking content. -->
    <Grid Margin="48,52,48,36">
        <StackPanel>
            <TextBlock Text="{Binding Heading, ElementName=Self}" FontSize="40" FontWeight="Bold"/>
            <TextBlock Text="{Binding Description, ElementName=Self}" FontSize="16" TextWrapping="Wrap" MaxWidth="620"
                       HorizontalAlignment="Left" Foreground="{DynamicResource MutedTextBrush}" Margin="2,10,0,0"/>
        </StackPanel>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,26" CornerRadius="28"
                Background="{DynamicResource SurfaceBrush}" MaxWidth="460">
            <StackPanel>
                <TextBlock Text="Раздел ещё в разработке" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="{Binding Note, ElementName=Self}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
