<Window x:Class="FlowDroid.AppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приложения — FlowDroid" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <Border Background="{StaticResource WindowBrush}" CornerRadius="20" Padding="30" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Приложения" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="Единая библиотека APK из всех профилей FlowDroid." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Content="Закрыть" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="16,9" Click="Close_Click"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,24,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="48" Padding="16,10" FontSize="15" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource OutlineBrush}" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по имени APK и профилю"/>
                <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="{StaticResource MutedTextBrush}"/>
            </Grid>
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,14,14">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid>
                                            <Border Width="48" Height="48" CornerRadius="14" Background="{StaticResource AccentPressedBrush}" HorizontalAlignment="Left">
                                                <TextBlock Text="APK" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="60,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding ProfileName}" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,14"/>
                                        <Button Grid.Row="2" Content="Открыть профиль" Style="{StaticResource PrimaryButton}" Padding="14,10" HorizontalAlignment="Stretch" Click="OpenProfile_Click" Tag="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Width="70" Height="70" CornerRadius="22" Background="{StaticResource SurfaceVariantBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="APK" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="EmptyTitle" Text="Библиотека пока пуста" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="Импортируй APK в любом профиле — он появится здесь." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>