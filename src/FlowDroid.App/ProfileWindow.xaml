<Window x:Class="FlowDroid.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Профиль — FlowDroid" Width="1000" Height="720" MinWidth="820" MinHeight="580"
        WindowStyle="None" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}"
        StateChanged="ProfileWindow_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#302A38" BorderThickness="1" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#100D14">
                <TextBlock Text="FlowDroid  /  Профиль" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="18,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeWindow_Click"/>
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="32,28,32,28">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock x:Name="ProfileTitle" FontSize="28" FontWeight="Bold"/>
                        <TextBlock x:Name="ProfileSubtitle" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Настройки профиля" Padding="16,11" Margin="0,0,10,0"
                                Background="{StaticResource SurfaceVariantBrush}" Foreground="{StaticResource TextBrush}"
                                BorderThickness="0" Click="Settings_Click"/>
                        <Button Content="+  Добавить APK" Style="{StaticResource PrimaryButton}" Click="AddApk_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="Приложения профиля" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ApkCountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18" Padding="10">
                        <ListView x:Name="ApkList" Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextBrush}" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="14" Margin="3,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource SurfaceBrush}">
                                                <TextBlock Text="APK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} байт}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Удалить" Padding="13,8"
                                                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                                                    BorderThickness="0" Tag="{Binding}" Click="RemoveApk_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                    <StackPanel x:Name="EmptyApkState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="62" Height="62" CornerRadius="20" Background="{StaticResource SurfaceVariantBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="APK" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="В этом профиле пока нет APK" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Добавь APK-файлы с компьютера, чтобы сохранить их в профиле."
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>