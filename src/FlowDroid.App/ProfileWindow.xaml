<Window x:Class="FlowDroid.ProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Профиль — FlowDroid" Width="980" Height="700" MinWidth="820" MinHeight="580" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Grid.Row="0" Margin="0,0,0,24"><StackPanel><TextBlock x:Name="ProfileTitle" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="ProfileSubtitle" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Настройки профиля" Padding="16,10" Margin="0,0,10,0" Background="{StaticResource SurfaceVariantBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" Click="Settings_Click"/><Button Content="+  Добавить APK" Style="{StaticResource PrimaryButton}" Click="AddApk_Click"/></StackPanel></Grid>
<Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Приложения профиля" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
<Grid Grid.Row="1"><ListView x:Name="ApkList" Background="{StaticResource SurfaceBrush}" BorderThickness="0" Foreground="{StaticResource TextBrush}" Padding="8"><ListView.ItemTemplate><DataTemplate><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/><TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} байт}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Content="Удалить" Padding="12,7" Background="{StaticResource SurfaceVariantBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" Tag="{Binding}" Click="RemoveApk_Click"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
<StackPanel x:Name="EmptyApkState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="В этом профиле пока нет APK" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Добавь APK-файлы с компьютера." Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Grid></Grid></Window>