<Window x:Class="FlowDroid.CreateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать профиль" Width="440" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Новый профиль" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Создай отдельную среду для своих приложений." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Название профиля" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <TextBox x:Name="ProfileNameBox" Height="42" Padding="12,8" FontSize="14" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource SurfaceVariantBrush}" CaretBrush="{StaticResource TextBrush}" Text="Мой профиль"/>
        </StackPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Версия Android" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <ComboBox x:Name="AndroidVersionBox" Height="38" SelectedIndex="0" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
                <ComboBoxItem Content="Android 14"/>
                <ComboBoxItem Content="Android 13"/>
                <ComboBoxItem Content="Android 12"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Отмена" Padding="16,9" Margin="0,0,9,0" Background="{StaticResource SurfaceVariantBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" Click="Cancel_Click"/>
            <Button Content="Создать профиль" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
