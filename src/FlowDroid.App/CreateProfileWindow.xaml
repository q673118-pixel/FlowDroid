<Window x:Class="FlowDroid.CreateProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Создать профиль" Width="500" Height="430" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="18" ClipToBounds="True" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#100D14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="FlowDroid  /  Новый профиль" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="18,0"/>
                <Button Grid.Column="1" Content="&#xE8BB;" Width="48" Height="42" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                        FontFamily="Segoe MDL2 Assets" FontSize="10" Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click">
                    <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="30,26,30,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Создать профиль" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="Отдельная Android-среда со своими приложениями и параметрами."
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,17">
                    <TextBlock Text="Название профиля" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ProfileNameBox" Height="44" Padding="13,10" FontSize="14"
                             Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource SurfaceVariantBrush}" CaretBrush="{StaticResource TextBrush}"
                             Text="Мой профиль" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Версия Android" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="AndroidVersionBox" Height="42" SelectedIndex="0"
                              Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}">
                        <ComboBoxItem Content="Android 14"/><ComboBoxItem Content="Android 13"/><ComboBoxItem Content="Android 12"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Отмена" Padding="18,11" Margin="0,0,10,0"
                            Background="{StaticResource SurfaceVariantBrush}" Foreground="{StaticResource TextBrush}"
                            BorderThickness="0" Click="Cancel_Click"/>
                    <Button Content="Создать профиль" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>