<Window x:Class="FlowDroid.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Внешний вид FlowDroid" Width="560" Height="570"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Border x:Name="SettingsRoot" Background="{StaticResource WindowBrush}" CornerRadius="20" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Внешний вид" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Настройте тему и поведение интерфейса FlowDroid." Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,7,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,28,0,0">
                <TextBlock Text="Режим оформления" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <ComboBox x:Name="ThemeModeBox" Height="46">
                    <ComboBoxItem Content="Тёмная" Tag="Dark"/>
                    <ComboBoxItem Content="Светлая" Tag="Light"/>
                    <ComboBoxItem Content="Системная Windows" Tag="System"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,22,0,0">
                <TextBlock Text="Цвет акцента" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9"/>
                <ComboBox x:Name="AccentBox" Height="46">
                    <ComboBoxItem Content="Purple — фирменный" Tag="Purple"/>
                    <ComboBoxItem Content="Ocean — океан" Tag="Ocean"/>
                    <ComboBoxItem Content="Emerald — изумруд" Tag="Emerald"/>
                    <ComboBoxItem Content="Sunset — закат" Tag="Sunset"/>
                    <ComboBoxItem Content="Rose — розовый" Tag="Rose"/>
                    <ComboBoxItem Content="Midnight — полночь" Tag="Midnight"/>
                </ComboBox>
            </StackPanel>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Движение интерфейса" FontSize="15" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AnimationsCheckBox" Content="Использовать анимации" IsChecked="True" Margin="0,12,0,0"
                              Foreground="{StaticResource TextBrush}" FontSize="14"/>
                    <TextBlock Text="Отключение убирает декоративные переходы и сокращает визуальные задержки."
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,24,0,0">
                <Button Content="Отмена" MinWidth="110" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Применить" MinWidth="130" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>