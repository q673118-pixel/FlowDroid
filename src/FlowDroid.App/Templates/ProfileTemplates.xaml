<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:FlowDroid.Models"
                    xmlns:vm="clr-namespace:FlowDroid.ViewModels">
    <!--
        Item templates for the profile grid. They expect the hosting ItemsControl to have ProfilesViewModel as its DataContext.
    -->

    <!-- "Create profile" tile: always the first item in the grid. -->
    <DataTemplate DataType="{x:Type vm:CreateProfileTile}">
        <Button Width="300" Height="252" Margin="0,0,20,20" Style="{DynamicResource TileButton}"
                Command="{Binding DataContext.CreateProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE710;" FontFamily="{DynamicResource IconFont}" FontSize="30"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Создать профиль" FontSize="21" FontWeight="SemiBold"
                           Margin="0,22,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="Настройте новый профиль и загрузите свои игры" FontSize="14" FontWeight="Normal"
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           MaxWidth="230" Margin="0,8,0,0"/>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Profile card. -->
    <DataTemplate DataType="{x:Type models:EmulatorProfile}">
        <Grid x:Name="CardRoot" Width="300" Height="252" Margin="0,0,20,20">
            <Border Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="28"/>
            <Border x:Name="CardOverlay" Background="{DynamicResource OverlayBrush}" CornerRadius="28"
                    Opacity="0" IsHitTestVisible="False"/>
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Width="52" Height="52" CornerRadius="18" Background="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="&#xE8EA;" FontFamily="{DynamicResource IconFont}" FontSize="24"
                               Foreground="{DynamicResource OnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                           Margin="0,16,0,0" TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="2" Margin="0,4,0,0" FontSize="13" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedTextBrush}">
                    <Run Text="{Binding AndroidVersion, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Resolution, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="3" Margin="0,3,0,0" FontSize="13"
                           Text="{Binding InstalledApkCount, StringFormat={}{0} APK}"
                           Foreground="{DynamicResource MutedTextBrush}"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{DynamicResource PrimaryButton}" Content="Открыть" Padding="0,12"
                            Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                    <Button Grid.Column="1" Style="{DynamicResource TonalIconButton}" Content="&#xE74D;"
                            Width="46" Height="46" Margin="10,0,0,0" ToolTip="Удалить профиль"
                            Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Grid>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardOverlay" Storyboard.TargetProperty="Opacity" To="0.05" Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CardOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
