<Window x:Class="FlowDroid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FlowDroid.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FlowDroid" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        StateChanged="MainWindow_StateChanged" Background="{StaticResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource OutlineBrush}"
            BorderThickness="1" CornerRadius="20" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="34,22,0,0">
                        <Canvas Width="62" Height="48">
                            <Ellipse Width="54" Height="34" Fill="{StaticResource AccentBrush}" Canvas.Left="4" Canvas.Top="12"/>
                            <Rectangle Width="54" Height="19" Fill="{StaticResource AccentBrush}" Canvas.Left="4" Canvas.Top="28"/>
                            <Ellipse Width="7" Height="7" Fill="#17121F" Canvas.Left="20" Canvas.Top="25"/>
                            <Ellipse Width="7" Height="7" Fill="#17121F" Canvas.Left="39" Canvas.Top="25"/>
                            <Rectangle Width="4" Height="18" RadiusX="2" Fill="{StaticResource AccentBrush}" Canvas.Left="15" Canvas.Top="0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><RotateTransform Angle="-28"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="4" Height="18" RadiusX="2" Fill="{StaticResource AccentBrush}" Canvas.Left="45" Canvas.Top="0" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><RotateTransform Angle="28"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                        <TextBlock Text="FlowDroid" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="24,18,24,0">
                        <Button Style="{StaticResource NavButton}" Background="{StaticResource AccentPressedBrush}" Foreground="White" IsHitTestVisible="False" Tag="Home" ToolTip="Главная">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="23" Width="42"/><TextBlock Text="Главная" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" IsEnabled="False" Margin="0,8,0,0" ToolTip="Раздел профилей будет выделен после реализации отдельной страницы">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="23" Width="42"/><TextBlock Text="Профили" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" IsEnabled="False" Margin="0,8,0,0" ToolTip="Раздел будет добавлен следующим этапом">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="23" Width="42"/><TextBlock Text="Приложения" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" IsEnabled="False" Margin="0,8,0,0" ToolTip="Раздел будет добавлен следующим этапом">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="23" Width="42"/><TextBlock Text="Файлы" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButton}" IsEnabled="False" Margin="0,8,0,0" ToolTip="Раздел будет добавлен следующим этапом">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23" Width="42"/><TextBlock Text="Настройки" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="36,0,34,22" VerticalAlignment="Bottom">
                        <Border Height="1" Background="{StaticResource OutlineBrush}" Margin="0,0,0,20"/>
                        <Button Style="{StaticResource NavButton}" IsEnabled="False" Padding="8,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="22" Width="42"/><TextBlock Text="О программе" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{StaticResource WindowBrush}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowControlButton}" Content="&#xE790;" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="AppearanceSettings_Click" ToolTip="Внешний вид"/>
                        <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindow_Click" ToolTip="Свернуть"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MaximizeWindow_Click" ToolTip="Развернуть"/>
                        <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click" ToolTip="Закрыть"/>
                    </StackPanel>
                </Grid>

                <Grid x:Name="MainContentRoot" Grid.Row="1" Margin="44,34,44,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Hero -->
                    <Grid Grid.Row="0" Margin="0,0,0,22">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FlowDroid" FontSize="62" FontWeight="Bold"/>
                            <TextBlock Text="Android-эмулятор для Windows" FontSize="25" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,0"/>
                        </StackPanel>
                        <Canvas Width="300" Height="150" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                            <Ellipse Width="270" Height="145" Fill="{StaticResource AccentBrush}" Canvas.Left="14" Canvas.Top="20"/>
                            <Rectangle Width="270" Height="80" Fill="{StaticResource AccentBrush}" Canvas.Left="14" Canvas.Top="85"/>
                            <Ellipse Width="34" Height="34" Fill="#17121F" Canvas.Left="88" Canvas.Top="86"/>
                            <Ellipse Width="34" Height="34" Fill="#17121F" Canvas.Left="178" Canvas.Top="86"/>
                            <Rectangle Width="13" Height="65" RadiusX="6" Fill="{StaticResource AccentBrush}" Canvas.Left="58" Canvas.Top="-22" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><RotateTransform Angle="-34"/></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="13" Height="65" RadiusX="6" Fill="{StaticResource AccentBrush}" Canvas.Left="227" Canvas.Top="-22" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><RotateTransform Angle="34"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                    </Grid>

                    <!-- Section header and search -->
                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Ваши профили" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="ProfileCountText" FontSize="14" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,7,0,0"/></StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="24" Padding="18,0" Height="66">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ProfileSearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="4,0" FontSize="16"
                                         ToolTip="Поиск профилей" TextChanged="ProfileSearchBox_TextChanged"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}" Height="66"
                                Content="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                ToolTip="Сортировка профилей" Click="SortProfiles_Click"/>
                    </Grid>

                    <!-- Profiles -->
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ProfilesList">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:EmulatorProfile}">
                                        <Border Width="350" MinHeight="280" Background="{StaticResource SurfaceBrush}" Loaded="ProfileCard_Loaded"
                                                CornerRadius="30" Padding="28" Margin="0,0,20,20"
                                                BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                                            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                            <StackPanel>
                                                <Border Width="78" Height="78" CornerRadius="39" Background="{StaticResource AccentPressedBrush}" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,24,0,5"/>
                                                <TextBlock Text="{Binding AndroidVersion}" FontSize="16" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding InstalledApkCount, StringFormat={}{0} APK}" FontSize="14"
                                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,22"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Открыть профиль" FontSize="15" Padding="18,14"
                                                            Click="OpenProfile_Click" Tag="{Binding}"/>
                                                    <Button Grid.Column="1" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                            Margin="10,0,0,0" Padding="14,10" ToolTip="Удалить профиль"
                                                            Click="DeleteProfile_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyState" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,10,0,0">
                            <Canvas Width="150" Height="150" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Rectangle Width="78" Height="126" RadiusX="20" RadiusY="20" Stroke="{StaticResource AccentBrush}" StrokeThickness="8"
                                           Canvas.Left="25" Canvas.Top="8" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="-18"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Ellipse Width="15" Height="15" Fill="{StaticResource AccentBrush}" Canvas.Left="66" Canvas.Top="58"/>
                                <Rectangle Width="8" Height="30" RadiusX="4" Fill="{StaticResource AccentBrush}" Canvas.Left="70" Canvas.Top="76" RenderTransformOrigin="0.5,0">
                                    <Rectangle.RenderTransform><RotateTransform Angle="-18"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Path Data="M 104,25 L 120,5 M 112,43 L 137,34" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" StrokeStartLineCap="Round"/>
                            </Canvas>
                            <TextBlock Text="У вас пока нет профилей" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Создайте профиль, чтобы запускать&#x0a;свои игры и приложения" FontSize="19"
                                       Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" Margin="0,12,0,26"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="&#xE710;    Создать профиль"
                                    FontFamily="Segoe UI, Segoe MDL2 Assets" FontSize="18" Padding="34,18"
                                    Click="CreateProfile_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="NoSearchResults" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Ничего не найдено" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Измените поисковый запрос и попробуйте снова." FontSize="15"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button x:Name="CreateProfileTile" Visibility="Collapsed" Width="350" Height="280"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource SecondaryButton}"
                                Click="CreateProfile_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="78" Height="78" CornerRadius="39" Background="{StaticResource AccentPressedBrush}">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Создать профиль" FontSize="23" FontWeight="SemiBold" Margin="0,24,0,5"/>
                                <TextBlock Text="Настройте новый профиль&#x0a;и загрузите свои игры" FontSize="16"
                                           Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>