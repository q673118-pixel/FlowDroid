<Window x:Class="FlowDroid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FlowDroid.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FlowDroid" Height="780" Width="1220" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="#302A38" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar: fully replaces the native white Windows caption. -->
            <Grid Grid.Row="0" Background="#100D14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="7" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="F" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="FlowDroid" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <TextBlock Text="  /  Android workspace" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeWindow_Click" ToolTip="Свернуть"/>
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE922;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeWindow_Click" ToolTip="Развернуть"/>
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindow_Click" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="12,17,0,14"/>
                            <Button Style="{StaticResource NavButton}" Background="{StaticResource SurfaceVariantBrush}"
                                    Foreground="{StaticResource TextBrush}" Content="  Профили" Margin="0,0,0,5"/>
                            <Button Style="{StaticResource NavButton}" Content="  Приложения" Margin="0,0,0,5"
                                    IsEnabled="False" ToolTip="Общий каталог появится после подключения Android Runtime."/>
                            <Button Style="{StaticResource NavButton}" Content="  Файлы" Margin="0,0,0,5"
                                    IsEnabled="False" ToolTip="Файловый обмен появится после подключения Android Runtime."/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Style="{StaticResource NavButton}" Content="  Настройки" IsEnabled="False"
                                    ToolTip="Глобальные настройки будут добавлены отдельным этапом."/>
                            <TextBlock Text="Версия 0.1.1" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="12,14,0,4"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="36,32,36,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="Профили" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="Твои Android-среды и установленные APK" FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="+  Создать профиль" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="CreateProfile_Click"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock x:Name="ProfileCountText" Text="0 профилей"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProfilesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:EmulatorProfile}">
                                        <Border Width="286" Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="20" Padding="19" Margin="0,0,16,16">
                                            <StackPanel>
                                                <Border Width="44" Height="44" CornerRadius="14"
                                                        Background="{StaticResource SurfaceVariantBrush}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="▣" FontSize="22"
                                                               Foreground="{StaticResource AccentHoverBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="17"
                                                           FontWeight="SemiBold" Margin="0,14,0,4"/>
                                                <TextBlock Text="{Binding AndroidVersion}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding InstalledApkCount, StringFormat={}{0} APK}"
                                                           FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="0,4,0,16"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Открыть"
                                                            HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                                            Click="OpenProfile_Click" Tag="{Binding}"/>
                                                    <Button Grid.Column="1" Content="Удалить" Padding="12,10"
                                                            Background="{StaticResource SurfaceVariantBrush}"
                                                            Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                                            Click="DeleteProfile_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Width="68" Height="68" CornerRadius="22"
                                    Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Center"
                                    Margin="0,0,0,18">
                                <TextBlock Text="▣" FontSize="30" Foreground="{StaticResource AccentHoverBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Пока нет профилей" FontSize="21" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Создай профиль, чтобы добавить свои APK." FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18"
                                       HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Создать профиль"
                                    Click="CreateProfile_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>