<Window x:Class="FlowDroid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:FlowDroid.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FlowDroid" Height="800" Width="1280" MinHeight="680" MinWidth="1020"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" StateChanged="MainWindow_StateChanged"
        Background="{StaticResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar: fully replaces the native white Windows caption. -->
            <Grid Grid.Row="0" Background="#100D14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <Canvas Width="18" Height="18">
                            <Ellipse Width="14" Height="9" Fill="#F4F0F8" Canvas.Left="2" Canvas.Top="2"/>
                            <Rectangle Width="14" Height="7" RadiusX="3" RadiusY="3" Fill="#F4F0F8" Canvas.Left="2" Canvas.Top="7"/>
                            <Ellipse Width="2" Height="2" Fill="#8065B5" Canvas.Left="5" Canvas.Top="5"/>
                            <Ellipse Width="2" Height="2" Fill="#8065B5" Canvas.Left="11" Canvas.Top="5"/>
                            <Rectangle Width="1.5" Height="4" Fill="#F4F0F8" Canvas.Left="5" Canvas.Top="0"/>
                            <Rectangle Width="1.5" Height="4" Fill="#F4F0F8" Canvas.Left="12" Canvas.Top="0"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="FlowDroid" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <TextBlock Text="  /  Android workspace" FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeWindow_Click" ToolTip="Свернуть"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeWindow_Click" ToolTip="Развернуть"/>
                    <Button Style="{StaticResource CloseWindowButton}" Content="&#xE8BB;"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseWindow_Click" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" Padding="16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="12,17,0,14"/>
                            <Button Style="{StaticResource NavButton}" Background="{StaticResource SurfaceVariantBrush}"
                                    Foreground="{StaticResource TextBrush}" Content="  Профили" Margin="0,0,0,5"/>

                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="14" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ANDROID WORKSPACE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="Локальная среда" FontSize="12" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock Text="APK остаются на этом компьютере" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Версия 0.4.0" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="12,14,0,4"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Margin="36,32,36,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="Твои Android-среды" FontSize="30" FontWeight="Bold"/>
                            <TextBlock Text="Изолированные профили, приложения и параметры запуска" FontSize="14"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                Content="+  Создать профиль" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="CreateProfile_Click"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProfileCountText" Text="0 профилей"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#D9A441" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Android Runtime настраивается в профиле" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ProfilesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:EmulatorProfile}">
                                        <Border Width="300" Background="{StaticResource SurfaceBrush}"
                                                CornerRadius="22" Padding="21" Margin="0,0,18,18" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <Border Width="44" Height="44" CornerRadius="14"
                                                        Background="{StaticResource SurfaceVariantBrush}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="▣" FontSize="22"
                                                               Foreground="{StaticResource AccentHoverBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="17"
                                                           FontWeight="SemiBold" Margin="0,14,0,4"/>
                                                <TextBlock Text="{Binding AndroidVersion}" FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="{Binding InstalledApkCount, StringFormat={}{0} APK}"
                                                           FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="0,4,0,16"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Style="{StaticResource PrimaryButton}" Content="Открыть"
                                                            HorizontalAlignment="Stretch" Margin="0,0,8,0"
                                                            Click="OpenProfile_Click" Tag="{Binding}"/>
                                                    <Button Grid.Column="1" Content="Удалить" Padding="12,10"
                                                            Background="{StaticResource SurfaceVariantBrush}"
                                                            Foreground="{StaticResource TextBrush}" BorderThickness="0"
                                                            Click="DeleteProfile_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Width="76" Height="76" CornerRadius="25" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1"
                                    Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Center"
                                    Margin="0,0,0,20">
                                <Canvas Width="42" Height="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="34" Height="22" Fill="{StaticResource AccentHoverBrush}" Canvas.Left="4" Canvas.Top="5"/>
                                    <Rectangle Width="34" Height="19" RadiusX="8" RadiusY="8" Fill="{StaticResource AccentHoverBrush}" Canvas.Left="4" Canvas.Top="16"/>
                                    <Ellipse Width="4" Height="4" Fill="#100E13" Canvas.Left="12" Canvas.Top="12"/>
                                    <Ellipse Width="4" Height="4" Fill="#100E13" Canvas.Left="26" Canvas.Top="12"/>
                                    <Rectangle Width="2" Height="9" Fill="{StaticResource AccentHoverBrush}" Canvas.Left="12" Canvas.Top="0"/>
                                    <Rectangle Width="2" Height="9" Fill="{StaticResource AccentHoverBrush}" Canvas.Left="28" Canvas.Top="0"/>
                                </Canvas>
                            </Border>
                            <TextBlock Text="Пока нет профилей" FontSize="23" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Создай первую Android-среду. В ней будут храниться свои APK, настройки и данные." FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,18"
                                       HorizontalAlignment="Center"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Создать профиль"
                                    Click="CreateProfile_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>