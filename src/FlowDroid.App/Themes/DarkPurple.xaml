<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Default FlowDroid palette: dark Material 3 surfaces with a purple accent.
        Every style references these keys through DynamicResource, so a palette can be swapped at runtime.
    -->

    <!-- Surfaces -->
    <Color x:Key="WindowColor">#0D0A13</Color>
    <Color x:Key="NavSurfaceColor">#181224</Color>
    <Color x:Key="SurfaceColor">#1C1529</Color>
    <Color x:Key="SurfaceVariantColor">#251C36</Color>
    <Color x:Key="SurfaceElevatedColor">#2F2444</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#5E40AE</Color>
    <Color x:Key="AccentHoverColor">#6E4FC4</Color>
    <Color x:Key="AccentPressedColor">#4E3495</Color>
    <Color x:Key="AccentBrightColor">#8B68F0</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>

    <!-- Text and lines -->
    <Color x:Key="TextColor">#F5F1FF</Color>
    <Color x:Key="MutedTextColor">#A898CC</Color>
    <Color x:Key="NavIconColor">#B9A8EE</Color>
    <Color x:Key="OutlineColor">#2F2544</Color>
    <Color x:Key="ScrollThumbColor">#3B2F55</Color>
    <Color x:Key="OverlayColor">#FFFFFF</Color>
    <Color x:Key="DangerColor">#E5484D</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="NavSurfaceBrush" Color="{StaticResource NavSurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="NavIconBrush" Color="{StaticResource NavIconColor}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource WindowColor}"/>
</ResourceDictionary>
