<Window x:Class="FlowDroid.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файлы — FlowDroid" Width="1120" Height="760" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
    <Border Background="{StaticResource WindowBrush}" CornerRadius="20" Padding="30" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Файлы" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="Импортированные APK и данные профилей на этом компьютере." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Открыть папку данных" Padding="15,9" Margin="0,0,8,0" Click="OpenDataFolder_Click"/>
                    <Button Content="Закрыть" Padding="15,9" Click="Close_Click"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,24,0,16">
                <TextBlock x:Name="StoragePathText" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="FileCountText" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="2">
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                    <ListView x:Name="FilesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="14" Margin="3,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Показать в папке" Padding="12,8" Margin="8,0,0,0" Tag="{Binding}" Click="ShowInFolder_Click"/>
                                        <Button Grid.Column="2" Content="Открыть APK" Padding="12,8" Margin="8,0,0,0" Tag="{Binding}" Click="OpenFile_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="Пока нет импортированных файлов" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="APK появятся здесь после импорта в профиль." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>